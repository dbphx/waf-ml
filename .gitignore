# Workspace artifacts (permitted smaller files)
#!data/*.csv
#!data/*.txt
#!models/*.joblib
#!reports/*

# Large Binary Artifacts (over GitHub 100MB limits without LFS)
*.safetensors
*.onnx.data
models/*/results/

# SecureBERT2 packaged weights under Go (large); keep only small metadata in git
application/go/securebert2/assets/**
!application/go/securebert2/assets/model_metadata.json

# End-to-end ONNX (~550MB+); regenerate via src/securebert2/export_for_go.py
models/securebert2/model.onnx

